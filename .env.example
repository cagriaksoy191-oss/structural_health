# ============================================================
#  Yapı Sağlığı - Ortam Değişkenleri Şablonu
#  Bu dosyayı ".env" adıyla kopyalayın ve kendi değerlerinizi yazın.
#  Komut: copy .env.example .env
# ============================================================

# Supabase Bağlantı Bilgileri (zorunlu)
# Dashboard: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Pinecone API (opsiyonel - sadece hafıza senkronizasyonu için)
# Dashboard: https://app.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here
