# ============================================================
#  Yapı Sağlığı - Ortam Değişkenleri Şablonu
#  Bu dosyayı ".env" adıyla kopyalayın ve kendi değerlerinizi yazın.
#  Komut: copy .env.example .env
# ============================================================

# Supabase Bağlantı Bilgileri (zorunlu)
# Dashboard: https://supabase.com/dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# Pinecone API (opsiyonel - sadece hafıza senkronizasyonu için)
# Dashboard: https://app.pinecone.io → API Keys
PINECONE_API_KEY=your_pinecone_api_key_here

# CORS: İzin verilen frontend adresleri (virgülle ayır)
# Local dev: localhost portlarını listele; Production: gerçek domain'i yaz
# Örnek production: https://yapisagligi.com,https://www.yapisagligi.com
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# AFAD Deprem API Ayarları (opsiyonel)
# Cache süresi (saniye). Varsayılan: 3600 (1 saat)
AFAD_CACHE_TTL=3600
